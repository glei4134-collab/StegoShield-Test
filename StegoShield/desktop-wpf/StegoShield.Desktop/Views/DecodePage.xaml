<UserControl x:Class="StegoShield.Desktop.Views.DecodePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🔍 数据提取工具" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#1A1A2E"
                   Margin="0,0,0,24"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Text="1. 选择包含隐藏数据的图片" FontSize="14" FontWeight="SemiBold" 
                           Foreground="#1A1A2E" Margin="0,0,0,8"/>

                <Border x:Name="imageDropZone" 
                        Background="#F8F9FA" 
                        BorderBrush="#DEE2E6" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Height="180"
                        AllowDrop="True"
                        DragEnter="ImageDropZone_DragEnter"
                        DragLeave="ImageDropZone_DragLeave"
                        Drop="ImageDropZone_Drop"
                        MouseLeftButtonUp="ImageDropZone_Click"
                        Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#667EEA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtDropHint" Text="点击选择图片或拖放图片到这里"
                                   FontSize="13" Foreground="#6C757D"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="txtImagePath" Text="" FontSize="11" 
                                   Foreground="#ADB5BD" HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="400"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="2. 提取选项" FontSize="14" FontWeight="SemiBold" 
                           Foreground="#1A1A2E" Margin="0,24,0,8"/>

                <Border Background="#F8F9FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔑 启用密钥解密" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ToggleButton x:Name="chkDecrypt" 
                                          Width="50" Height="26"
                                          Checked="ChkDecrypt_Changed" 
                                          Unchecked="ChkDecrypt_Changed">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="#DEE2E6" CornerRadius="13" Padding="2">
                                            <Ellipse x:Name="thumb" Width="22" Height="22" Fill="White">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#667EEA"/>
                                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>

                        <StackPanel x:Name="pnlDecryptKey" Visibility="Collapsed">
                            <TextBlock Text="请输入解密密钥" FontSize="12" Foreground="#6C757D" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtDecryptKey" 
                                     FontSize="13" 
                                     Padding="12,10"
                                     BorderBrush="#DEE2E6"/>
                            <TextBlock Text="如果嵌入时启用了加密，提取时需要输入相同的密钥" 
                                       FontSize="11" Foreground="#ADB5BD" 
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <TextBlock Text="🛡️ 抗压缩解码" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ToggleButton x:Name="chkDecompress" Width="50" Height="26">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="border" Background="#DEE2E6" CornerRadius="13" Padding="2">
                                    <Ellipse x:Name="thumb" Width="22" Height="22" Fill="White">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#667EEA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Button x:Name="btnDecode" 
                            Content="� 提取文本"
                            Padding="24,14"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#667EEA"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnDecode_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5568D3"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="btnDecodeFile" 
                            Content="� 提取文件"
                            Margin="12,0,0,0"
                            Padding="20,14"
                            FontSize="14"
                            Background="White"
                            Foreground="#667EEA"
                            BorderBrush="#667EEA"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnDecodeFile_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F0F0FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <ProgressBar x:Name="progressBar" 
                             Height="4" 
                             Margin="0,0,0,16"
                             Visibility="Collapsed"
                             Foreground="#667EEA"
                             Background="#E9ECEF"/>

                <TextBlock x:Name="txtStatus" 
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="💡 使用提示" FontSize="14" FontWeight="SemiBold" 
                               Foreground="#1A1A2E" Margin="0,0,0,12"/>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#6C757D">
                        <Run FontWeight="SemiBold">提取前提：</Run><LineBreak/>
                        <Run>需要使用隐写工具处理过的图片才能提取数据</Run><LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold">自动检测：</Run><LineBreak/>
                        <Run>推荐使用自动检测，系统会自动识别算法</Run><LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold">解密密钥：</Run><LineBreak/>
                        <Run>如果图片使用了加密，提取时需要输入正确的密钥</Run><LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold">抗压缩：</Run><LineBreak/>
                        <Run>如果嵌入时启用了抗压缩，提取时也需要启用</Run>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>