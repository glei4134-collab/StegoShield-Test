<Window x:Class="StegoShield.Desktop.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="注册账号 - StegoShield"
        Height="560"
        Width="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    
    <Border Background="White" CornerRadius="8" Margin="10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.25" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="#667EEA" 
                    CornerRadius="8,8,0,0"
                    Padding="15,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="注册新账号" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="← 返回登录"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="11"
                            Cursor="Hand"
                            Click="BtnBack_Click"
                            Padding="8,4"/>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Margin="0,0,80,0"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        CornerRadius="12" Width="24" Height="24">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FF3B30"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="25,15,25,15">

                    <Border Width="56" Height="56" CornerRadius="8" Background="#667EEA" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.25" Color="#667EEA"/>
                        </Border.Effect>
                        <TextBlock Text="🛡️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="创建您的账号" 
                               FontSize="12" 
                               Foreground="#666666" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="用户名" FontSize="11" Foreground="#666666"/>
                        <TextBlock Text=" *" FontSize="11" Foreground="#FF3B30" FontWeight="Bold"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White">
                            <Grid>
                                <TextBox x:Name="txtUsername"
                                         Text=""
                                         MaxLength="50"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="10,7"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtUsername_TextChanged"/>
                                <TextBlock x:Name="lblUsername" 
                                           Text="3-20个字符，字母或数字" 
                                           Foreground="#CCCCCC" 
                                           Padding="10,7" 
                                           FontSize="12"
                                           IsHitTestVisible="False"
                                           Visibility="Visible"/>
                            </Grid>
                        </Border>
                        <Button x:Name="btnClearUsername"
                                Grid.Column="1"
                                Content="✕"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#AAAAAA"
                                FontSize="10"
                                Margin="5,0,0,0"
                                Cursor="Hand"
                                Click="BtnClearUsername_Click"
                                Padding="6,4"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="邮箱" FontSize="11" Foreground="#666666"/>
                        <TextBlock Text=" *" FontSize="11" Foreground="#FF3B30" FontWeight="Bold"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White">
                            <Grid>
                                <TextBox x:Name="txtEmail"
                                         Text=""
                                         MaxLength="100"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="10,7"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtEmail_TextChanged"/>
                                <TextBlock x:Name="lblEmail" 
                                           Text="用于找回密码和接收通知" 
                                           Foreground="#CCCCCC" 
                                           Padding="10,7" 
                                           FontSize="12"
                                           IsHitTestVisible="False"
                                           Visibility="Visible"/>
                            </Grid>
                        </Border>
                        <Button x:Name="btnClearEmail"
                                Grid.Column="1"
                                Content="✕"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#AAAAAA"
                                FontSize="10"
                                Margin="5,0,0,0"
                                Cursor="Hand"
                                Click="BtnClearEmail_Click"
                                Padding="6,4"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="密码" FontSize="11" Foreground="#666666"/>
                        <TextBlock Text=" *" FontSize="11" Foreground="#FF3B30" FontWeight="Bold"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White">
                            <Grid>
                                <PasswordBox x:Name="txtPassword"
                                             Password=""
                                             MaxLength="20"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="10,7"
                                             FontSize="12"
                                             VerticalContentAlignment="Center"
                                             PasswordChanged="TxtPassword_PasswordChanged"/>
                                <TextBlock x:Name="lblPassword" 
                                           Text="至少6位，区分大小写" 
                                           Foreground="#CCCCCC" 
                                           Padding="10,7" 
                                           FontSize="12"
                                           IsHitTestVisible="False"
                                           Visibility="Visible"/>
                            </Grid>
                        </Border>
                        <Button x:Name="btnTogglePassword"
                                Grid.Column="1"
                                Content="👁"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Margin="5,0,0,0"
                                Cursor="Hand"
                                Click="BtnTogglePassword_Click"
                                Padding="6,4"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="pwdStrengthBorder" Background="#F5F5F5" CornerRadius="4" Padding="8,5">
                            <StackPanel>
                                <TextBlock x:Name="txtPwdStrength" Text="密码强度：未输入" FontSize="10" Foreground="#999999" Margin="0,0,0,4"/>
                                <Border x:Name="pwdStrengthBar" Height="4" Background="#E0E0E0" CornerRadius="2"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="确认密码" FontSize="11" Foreground="#666666"/>
                        <TextBlock Text=" *" FontSize="11" Foreground="#FF3B30" FontWeight="Bold"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White">
                            <Grid>
                                <PasswordBox x:Name="txtConfirmPassword"
                                             Password=""
                                             MaxLength="20"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="10,7"
                                             FontSize="12"
                                             VerticalContentAlignment="Center"
                                             PasswordChanged="TxtConfirmPassword_PasswordChanged"/>
                                <TextBlock x:Name="lblConfirmPassword" 
                                           Text="再次输入密码" 
                                           Foreground="#CCCCCC" 
                                           Padding="10,7" 
                                           FontSize="12"
                                           IsHitTestVisible="False"
                                           Visibility="Visible"/>
                            </Grid>
                        </Border>
                        <Button x:Name="btnToggleConfirmPassword"
                                Grid.Column="1"
                                Content="👁"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Margin="5,0,0,0"
                                Cursor="Hand"
                                Click="BtnToggleConfirmPassword_Click"
                                Padding="6,4"/>
                    </Grid>

                    <CheckBox x:Name="chkAgreeTerms"
                              FontSize="11"
                              Foreground="#666666"
                              Margin="0,0,0,10"
                              Cursor="Hand"
                              VerticalContentAlignment="Center">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="checkBorder" Width="14" Height="14" CornerRadius="3" BorderBrush="#CCCCCC" BorderThickness="1" Background="White" Margin="0,0,5,0">
                                        <TextBlock x:Name="checkMark" Text="✓" Foreground="#667EEA" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="checkBorder" Property="Background" Value="#667EEA"/>
                                        <Setter TargetName="checkBorder" Property="BorderBrush" Value="#667EEA"/>
                                        <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="我已阅读并同意" Foreground="#666666"/>
                            <TextBlock Text="《服务条款》" Foreground="#667EEA" TextDecorations="Underline" Margin="4,0"/>
                            <TextBlock Text="和" Foreground="#666666"/>
                            <TextBlock Text="《隐私政策》" Foreground="#667EEA" TextDecorations="Underline" Margin="4,0"/>
                        </StackPanel>
                    </CheckBox>

                    <Button x:Name="btnRegister"
                            Content="注 册 / REGISTER"
                            Background="#667EEA"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Padding="0,10"
                            BorderThickness="0"
                            Click="BtnRegister_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="注 册 / REGISTER" x:Name="btnText"/>
                                        <TextBlock x:Name="btnSpinner" Text="" Visibility="Collapsed" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5568D3"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#4455B3"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="已有账号？"
                               FontSize="11"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <Button Content="返回登录"
                            Background="Transparent"
                            Foreground="#667EEA"
                            FontSize="11"
                            Cursor="Hand"
                            BorderThickness="0"
                            Margin="0,2,0,0"
                            Click="BtnBack_Click"/>
                </StackPanel>

            <Border Grid.Row="2" Background="#F8F8F8" CornerRadius="0,0,8,8" Padding="12,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="statusIndicator" Width="7" Height="7" Fill="#FF9500" Margin="0,0,5,0">
                        <Ellipse.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.5" Color="#FF9500"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="txtStatus" 
                               Text="准备注册..." 
                               FontSize="10"
                               Foreground="#888888"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>