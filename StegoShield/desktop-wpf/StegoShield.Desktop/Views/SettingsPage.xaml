<UserControl x:Class="StegoShield.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" MaxWidth="800">
            <TextBlock Text="⚙️ 设置中心" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#1A1A2E"
                       Margin="0,0,0,24"/>

            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="👤 账户设置" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#1A1A2E" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="用户名" VerticalAlignment="Center" Foreground="#6C757D"/>
                        <TextBlock x:Name="txtUsername" Grid.Column="1" Text="未登录" 
                                   VerticalAlignment="Center" Foreground="#1A1A2E"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="邮箱" VerticalAlignment="Center" Foreground="#6C757D"/>
                        <TextBlock x:Name="txtEmail" Grid.Column="1" Text="未绑定" 
                                   VerticalAlignment="Center" Foreground="#1A1A2E"/>
                        <Button x:Name="btnChangeEmail" Grid.Column="2"
                                Content="修改"
                                Padding="12,6"
                                FontSize="11"
                                Background="Transparent"
                                Foreground="#667EEA"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnChangeEmail_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="密码" VerticalAlignment="Center" Foreground="#6C757D"/>
                        <TextBlock Text="••••••••" Grid.Column="1" 
                                   VerticalAlignment="Center" Foreground="#1A1A2E"/>
                        <Button x:Name="btnChangePassword" Grid.Column="2"
                                Content="修改密码"
                                Padding="12,6"
                                FontSize="11"
                                Background="Transparent"
                                Foreground="#667EEA"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnChangePassword_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📁 文件设置" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#1A1A2E" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="默认输出路径" VerticalAlignment="Center" Foreground="#6C757D"/>
                        <TextBox x:Name="txtDefaultPath" Grid.Column="1" 
                                 IsReadOnly="True" FontSize="12" Padding="8"/>
                        <Button x:Name="btnBrowseDefault" Grid.Column="2"
                                Content="浏览"
                                Margin="8,0,0,0"
                                Padding="12,8"
                                Background="#667EEA"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnBrowseDefault_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="图片质量" VerticalAlignment="Center" Foreground="#6C757D"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="sliderQuality" 
                                    Width="200"
                                    Minimum="50" 
                                    Maximum="100" 
                                    Value="95"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtQuality" Text="95%" 
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#1A1A2E"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="chkKeepBackup" Content="保留原文件备份" 
                             IsChecked="True" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔔 通知设置" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#1A1A2E" Margin="0,0,0,16"/>

                    <CheckBox x:Name="chkNotifications" Content="启用系统通知" 
                              IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkSound" Content="启用声音提示" 
                              IsChecked="True" Margin="0,0,0,8"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🌐 服务器设置 (VIP)" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#1A1A2E" Margin="0,0,0,16"/>

                    <CheckBox x:Name="chkServerMode" Content="启用VIP服务器模式" 
                              Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="端口" VerticalAlignment="Center" Foreground="#6C757D"/>
                        <TextBox x:Name="txtServerPort" Grid.Column="1" 
                                 Text="8080" FontSize="12" Padding="8"/>
                        <Button x:Name="btnStartServer" Grid.Column="2"
                                Content="启动服务器"
                                HorizontalAlignment="Left"
                                Margin="16,0,0,0"
                                Padding="16,8"
                                Background="#667EEA"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnStartServer_Click"/>
                    </Grid>

                    <TextBlock x:Name="txtServerStatus" 
                               Text="服务器状态: 未启动"
                               FontSize="12"
                               Foreground="#6C757D"/>
                </StackPanel>
            </Border>

            <Button x:Name="btnSaveSettings" 
                    Content="💾 保存设置"
                    Padding="24,14"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#667EEA"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    Click="BtnSaveSettings_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5568D3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
