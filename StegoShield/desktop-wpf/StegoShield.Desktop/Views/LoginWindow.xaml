<Window x:Class="StegoShield.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StegoShield - 登录"
        Height="520"
        Width="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    
    <Border Background="White" CornerRadius="8" Margin="10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.25" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="#667EEA" 
                    CornerRadius="8,8,0,0"
                    Padding="15,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="StegoShield" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        CornerRadius="12" Width="24" Height="24">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FF3B30"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="25,15,25,15" VerticalAlignment="Center">

                <Border Width="56" Height="56" CornerRadius="8" Background="#667EEA" Margin="0,0,0,10" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.25" Color="#667EEA"/>
                    </Border.Effect>
                    <TextBlock Text="🛡️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="专业级图片隐写工具" 
                           FontSize="10" 
                           Foreground="#888888" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White">
                        <Grid>
                            <TextBox x:Name="txtUsername"
                                     Text=""
                                     MaxLength="50"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="10,7"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="lblUsername" 
                                       Text="用户名 / Username" 
                                       Foreground="#AAAAAA" 
                                       Padding="10,7" 
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       Visibility="Visible"/>
                        </Grid>
                    </Border>
                    <Button x:Name="btnClearUsername"
                            Grid.Column="1"
                            Content="✕"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#AAAAAA"
                            FontSize="10"
                            Margin="5,0,0,0"
                            Cursor="Hand"
                            ToolTip="清除"
                            Click="BtnClearUsername_Click"
                            Padding="6,4"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White">
                        <Grid>
                            <PasswordBox x:Name="txtPassword"
                                         Password=""
                                         MaxLength="20"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="10,7"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="lblPassword" 
                                       Text="密码 / Password" 
                                       Foreground="#AAAAAA" 
                                       Padding="10,7" 
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       Visibility="Visible"/>
                        </Grid>
                    </Border>
                    <Button x:Name="btnTogglePassword"
                            Grid.Column="1"
                            Content="👁"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Margin="5,0,0,0"
                            Cursor="Hand"
                            ToolTip="显示密码"
                            Click="BtnTogglePassword_Click"
                            Padding="6,4"/>
                </Grid>

                <CheckBox x:Name="chkRememberMe"
                          Content="记住我 / Remember Me"
                          FontSize="11"
                          Foreground="#666666"
                          Margin="0,0,0,12"
                          Cursor="Hand"
                          VerticalContentAlignment="Center">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="checkBorder" Width="14" Height="14" CornerRadius="3" BorderBrush="#CCCCCC" BorderThickness="1" Background="White" Margin="0,0,5,0">
                                    <TextBlock x:Name="checkMark" Text="✓" Foreground="#667EEA" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="checkBorder" Property="Background" Value="#667EEA"/>
                                    <Setter TargetName="checkBorder" Property="BorderBrush" Value="#667EEA"/>
                                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>

                <Button x:Name="btnLogin"
                        Content="登 录 / LOGIN"
                        Background="#667EEA"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Padding="0,10"
                        Margin="0,0,0,8"
                        BorderThickness="0"
                        Click="BtnLogin_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#5568D3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#4455B3"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnRegister"
                        Content="注 册 / REGISTER"
                        Background="White"
                        Foreground="#667EEA"
                        FontSize="12"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Padding="0,10"
                        BorderBrush="#667EEA"
                        BorderThickness="1"
                        Click="BtnRegister_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#F5F5FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#EEEEFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <Border Grid.Row="2" Background="#F8F8F8" CornerRadius="0,0,8,8" Padding="12,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="statusIndicator" Width="7" Height="7" Fill="#FF9500" Margin="0,0,5,0">
                        <Ellipse.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.5" Color="#FF9500"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="txtStatus" 
                               Text="正在连接... / Connecting..." 
                               FontSize="10"
                               Foreground="#888888"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>